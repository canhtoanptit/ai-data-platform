# Copy this file to `.env` and fill in your Snowflake trial values.
# `make` loads it automatically via `uv run --env-file .env`.
# Never commit the real `.env` (it is gitignored).

SNOWFLAKE_ACCOUNT=abc12345.ap-southeast-2   # your account identifier / locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN                  # or a dedicated TRANSFORMER role
SNOWFLAKE_DATABASE=ANZ_COLLECTIONS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=DBT_TOAN                    # your personal dev schema

# --- Local Postgres warehouse (docker compose, `--target local`) -------------
# These are OPTIONAL: .dbt/profiles.yml already defaults every one of them to
# the values below, which match the `postgres` service in docker-compose.yml.
# Only uncomment/override if you change the container (e.g. host port clash).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432                         # host port; use 5433 if 5432 is taken
# POSTGRES_DB=platform
# POSTGRES_USER=platform
# POSTGRES_PASSWORD=platform
# POSTGRES_SCHEMA=analytics                  # base schema; marts -> analytics_marts

# --- AI chat (/api/chat, the "Ask AI" page) ----------------------------------
# Free key, no credit card: https://console.groq.com -> API Keys.
# Without it the chat endpoint answers 503 and the page shows setup
# instructions; everything else in the stack works unchanged.
# GROQ_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile          # Groq's flagship production model
# LLM_BASE_URL=https://api.groq.com/openai/v1  # any OpenAI-compatible endpoint

# --- AI cost + abuse controls ------------------------------------------------
# Both default to the values shown, in api/app/config.py — uncomment only to
# change them. The budget is a SQL sum over platform_ops.llm_calls (the table
# every chat request traces to), so today's spend is visible on the dashboard's
# Runs page and enforced from the same numbers. It resets at midnight UTC.
# LLM_DAILY_TOKEN_BUDGET=200000              # tokens/day; /api/chat 429s past it
# CHAT_RATE_LIMIT=10/minute                  # per client IP, /api/chat only
