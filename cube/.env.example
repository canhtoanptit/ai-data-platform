# Copy to cube/.env. How Cube connects to Snowflake (read-only role recommended).
CUBEJS_DB_TYPE=snowflake
CUBEJS_DB_SNOWFLAKE_ACCOUNT=abc12345.ap-southeast-2
CUBEJS_DB_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
CUBEJS_DB_SNOWFLAKE_ROLE=REPORTER
CUBEJS_DB_NAME=ANZ_COLLECTIONS
CUBEJS_DB_USER=your_user
CUBEJS_DB_PASS=your_password

# Dev-mode API + a signing secret for API tokens (any random string for local).
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=change_me_to_a_long_random_string
