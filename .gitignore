.env
.venv/
target/
logs/
.DS_Store
# profiles.yml only references env vars (no secrets) so it's safe to commit;
# .user.yml holds an anonymous id, so keep that ignored.
.dbt/.user.yml
# Python
__pycache__/
*.pyc

# Eval reports: one JSON per `make eval` run. Outputs, not source — a committed
# one would be stale by the next commit, and the interesting comparison is
# between two runs on your own machine.
api/evals/results/

# JetBrains IDE
.idea/

# Airflow runtime state. The compose service keeps ALL of it in named volumes
# (`airflow_state` for the SQLite metadata DB and task logs, `uploads` for
# staged files) precisely so nothing lands in the repo — and ./airflow/dags is
# mounted read-only, so the scheduler cannot even write __pycache__ there.
# These entries are belt-and-braces for anyone who follows the older
# "practise locally in a virtualenv" path in airflow/README.md, where
# AIRFLOW_HOME does end up on disk wherever you point it.
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/standalone_admin_password.txt
airflow/uploads/
